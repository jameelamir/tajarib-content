# Copy to .env and fill in values. Used by docker-compose.

# Required: API keys
GROQ_API_KEY=
LLM_API_KEY=

# Optional: Anthropic API key (LLM_API_KEY takes precedence if both set)
ANTHROPIC_API_KEY=

# Optional: alternate LLM endpoint (e.g., Haimaker)
LLM_BASE_URL=

# Webhook secret — generate with: openssl rand -hex 32
# Set this same value in the GitHub repo webhook "Secret" field.
WEBHOOK_SECRET=

# Branch the webhook will deploy on push (default: main)
WEBHOOK_BRANCH=main

# Host port for the dashboard (default 7430)
HOST_PORT=7430

# Host port for the webhook listener (default 9000)
WEBHOOK_PORT=9000
